# ========================================================
# CAFE RUANG NAMU — SERVER ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite with WAL & ACID)
DB_PATH=data/ruang_namu.db

# Authentication
JWT_SECRET=replace_this_with_a_secure_random_64_character_string_in_production
JWT_EXPIRES_IN=24h

# Payment Gateway Configuration
# Options: MOCK_SANDBOX | MIDTRANS
PAYMENT_PROVIDER=MOCK_SANDBOX

# Official Midtrans Core API (Required for Real Dynamic QRIS)
# Dapatkan kredensial ini di dashboard resmi https://dashboard.midtrans.com/
# Sandbox: https://dashboard.sandbox.midtrans.com/
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id_here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_client_key_here
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_server_key_here

# Catatan GoPay Merchant:
# Akun GoPay Merchant umum tidak menyediakan API langsung untuk website.
# Untuk integrasi QRIS dinamis website otomatis, gunakan akun Midtrans (anak perusahaan GoTo)
# dengan mengaktifkan metode pembayaran GoPay / QRIS di portal Midtrans.
